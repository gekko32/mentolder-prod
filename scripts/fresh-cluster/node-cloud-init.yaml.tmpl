#cloud-config
# Runbook 5.2/5.3: Grundprovisionierung eines fleet-Knotens beim Rebuild
# (hcloud server rebuild/create --user-data-from-file). Gerendert von
# scripts/fresh-cluster/fleet.sh userdata, Platzhalter per envsubst:
#   NODE_NAME, SSH_PUBKEY, TS_AUTHKEY, PRIVATE_CIDR, EXTRA_RUNCMD
# Hetzner speichert user-data im Klartext (Metadaten-Dienst). Deshalb nur einen
# Einmal-Auth-Key (single use, 1 h gueltig) eintragen, nie den reusable fleet-Key.
hostname: ${NODE_NAME}
preserve_hostname: false
users:
  - name: gekko
    groups: sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${SSH_PUBKEY}
disable_root: true
ssh_pwauth: false

package_update: true
package_upgrade: true
packages:
  - unattended-upgrades
  - ufw
  - fail2ban
  - curl
  - jq
  - open-iscsi
  - nfs-common

write_files:
  - path: /etc/ssh/sshd_config.d/10-hardening.conf
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      AllowUsers gekko
  - path: /etc/sysctl.d/99-k3s.conf
    content: |
      net.ipv4.ip_forward=1
      net.bridge.bridge-nf-call-iptables=1
      fs.inotify.max_user_instances=8192
      fs.inotify.max_user_watches=1048576
      vm.max_map_count=262144
  - path: /etc/modules-load.d/k3s.conf
    content: |
      br_netfilter
  - path: /etc/fail2ban/jail.d/sshd.local
    content: |
      [sshd]
      enabled = true
      maxretry = 5
      bantime = 3600
  - path: /etc/tailscale/auth-key
    permissions: '0600'
    content: ${TS_AUTHKEY}

runcmd:
  - modprobe br_netfilter
  - sysctl --system
  - dpkg-reconfigure -f noninteractive unattended-upgrades
  # Firewall: oeffentlich nur, was der Altcluster oeffentlich brauchte (ohne
  # 6443/10250/2379/8472, die dort offen standen). Clusterports nur privat/Tailnet.
  - ufw --force reset
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw limit 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw allow 3478 comment 'TURN'
  - ufw allow 5349/tcp comment 'TURNS'
  - ufw allow 49152:49252/udp comment 'TURN relay'
  - ufw allow 8188/tcp comment 'Janus WS (HPB)'
  - ufw allow 20000:20200/udp comment 'Janus RTP'
  - ufw allow from ${PRIVATE_CIDR}
  - ufw allow in on tailscale0
  - ufw allow from 10.42.0.0/16
  - ufw allow from 10.43.0.0/16
  - ufw route allow in on cni0 out on flannel.1
  - ufw route allow in on flannel.1 out on cni0
  - ufw route allow in on cni0 out on cni0
  - ufw --force enable
  - systemctl enable --now fail2ban
  - systemctl restart ssh
  # Tailscale: Einmal-Key aus der Datei, danach vernichten
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key=file:/etc/tailscale/auth-key --hostname=${NODE_NAME} --advertise-tags=tag:fleet --accept-routes=false
  - shred -u /etc/tailscale/auth-key
${EXTRA_RUNCMD}
  - touch /var/lib/fleet-node-ready
