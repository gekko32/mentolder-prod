# Image-Digests. Leer = der geplante Render folgt :latest von ghcr.io/paddione/website und workspace-brett.
# Gepinnte Image-Digests fuer den Render. Leer = der Workflow loest ghcr.io/paddione/<image>:latest
# anonym auf. workspace-brett ist privat (403 ohne Token), hier einen Digest eintragen oder das
# Paket oeffentlich machen. Ein leerer, nicht aufloesbarer Wert bricht den Render ab.
WEBSITE_IMAGE_DIGEST=
BRETT_IMAGE_DIGEST=
